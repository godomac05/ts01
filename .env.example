# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar. Por defecto usamos claude-opus-5; puedes cambiar a claude-sonnet-5
# para reducir costo en un bot de soporte de alto volumen.
CLAUDE_MODEL=claude-opus-5

# --- Meta WhatsApp Cloud API ---
# Token de acceso (temporal o permanente) generado en Meta for Developers.
WHATSAPP_TOKEN=
# ID del número de teléfono de WhatsApp Business (Phone Number ID), no el número en sí.
WHATSAPP_PHONE_NUMBER_ID=
# Token que tú inventas y configuras también en el webhook de Meta (verificación).
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-token-secreto
# Versión de la Graph API a usar.
WHATSAPP_API_VERSION=v21.0

# --- Configuración del bot ---
# Nombre de tu plataforma, se usa en el prompt del asistente.
PLATFORM_NAME=TractoSoft
# Datos de contacto de soporte humano que el bot puede recomendar cuando no sepa la respuesta.
SUPPORT_CONTACT=soporte@tuplataforma.com

# URL pública donde corre este servidor (tu túnel de ngrok en pruebas, o tu
# dominio real en producción). Necesaria para poder enviar las plantillas
# descargables de la carpeta plantillas/ por WhatsApp.
PUBLIC_BASE_URL=https://tu-url-publica.ngrok-free.app

PORT=3000
